@startuml clases-capas
!include estilo.iuml
' Diagrama de clases de diseño: vistas (JSP), controles (Servlets) y persistencia (DAO).
' Refina los diagramas «Interfaces y controles» de la Tarea 1: cada «boundary» es una JSP
' y cada «control» es un Servlet con las mismas operaciones.
left to right direction
skinparam nodesep 14
skinparam ranksep 90
hide empty members
hide <<JSP>> circle

package "vista (JSP) — «boundary»" {
  class "formularioReporte.jsp" as fr <<JSP>>
  class "mapaReportes.jsp" as mr <<JSP>>
  class "detalleReporte.jsp" as dr <<JSP>>
  class "formularioReclamacion.jsp" as frc <<JSP>>
  class "panelDevolucion.jsp" as pd <<JSP>>
  class "vistaAcuerdoEntrega.jsp" as va <<JSP>>
}

package "controlador (Servlets) — «control»" {
  abstract class ControlBase {
    # actor(request) : Usuario
    # leerId(request, parametro) : UUID
    # mostrar(vista, request, response)
    # redirigir(request, response, ruta)
  }
  class ControlRegistroReporte <<@WebServlet("/reportes/nuevo")>> {
    # doGet(request, response)
    # doPost(request, response)
    + registrarReporte(usuario, datos) : Reporte
  }
  class ControlConsultaReportes <<@WebServlet("/reportes", "/reportes/detalle")>> {
    # doGet(request, response)
    + consultarReportes(filtros) : List<Reporte>
    + consultarDetallePublico(idReporte) : DatosPublicos
  }
  class ControlReclamaciones <<@WebServlet("/reclamaciones/nueva")>> {
    # doGet(request, response)
    # doPost(request, response)
    + obtenerPreguntas(actor, reporteId) : List<PreguntaVerificacion>
    + registrarReclamacion(actor, reporteId, respuestas) : Reclamacion
  }
  class ControlDevoluciones <<@WebServlet("/devoluciones")>> {
    # doGet(request, response)
    # doPost(request, response)
    + listarPendientes(actor, reporteId) : List<Reclamacion>
    + consultarRespuestas(actor, reclamacionId) : List<RespuestaVerificacion>
    + aceptarReclamacion(actor, id) : void
    + proponerEntrega(actor, id, lugar, fecha) : AcuerdoEntrega
    + consultarAcuerdo(actor, id) : AcuerdoEntrega
    + confirmarAcuerdo(actor, id) : void
    + confirmarDevolucion(actor, id, fecha) : void
  }
}

package "persistencia (DAO + JPA)" {
  abstract class "GenericDAO<T>" as GenericDAO {
    + guardar(entidad : T) : T
    + actualizar(entidad : T) : T
    + buscarPorId(id : UUID) : T
  }
  class ReporteDAO {
    + consultarActivos(filtros) : List<Reporte>
    + listarPorAutor(autor) : List<Reporte>
  }
  class ReclamacionDAO {
    + listarPendientes(reporte) : List<Reclamacion>
    + buscarEnCurso(reporte) : Reclamacion
    + existeDe(reclamante, reporte) : boolean
    + listarPorReclamante(reclamante) : List<Reclamacion>
  }
  class CategoriaDAO {
    + listarTodas() : List<Categoria>
  }
  class UsuarioDAO {
    + buscarPorCorreo(correo) : Usuario
    + obtenerORegistrar(nombre, correo) : Usuario
  }
  class JPAUtil {
    + {static} getEntityManager() : EntityManager
    + {static} cerrarEntityManager() : void
  }
}

fr ..> ControlRegistroReporte : usa
mr ..> ControlConsultaReportes : usa
dr ..> ControlConsultaReportes : usa
dr ..> ControlReclamaciones : usa
frc ..> ControlReclamaciones : usa
pd ..> ControlDevoluciones : usa
va ..> ControlDevoluciones : usa

ControlBase <|-- ControlRegistroReporte
ControlBase <|-- ControlConsultaReportes
ControlBase <|-- ControlReclamaciones
ControlBase <|-- ControlDevoluciones

ControlRegistroReporte --> ReporteDAO
ControlRegistroReporte --> CategoriaDAO
ControlConsultaReportes --> ReporteDAO
ControlReclamaciones --> ReporteDAO
ControlReclamaciones --> ReclamacionDAO
ControlDevoluciones --> ReclamacionDAO
ControlBase --> UsuarioDAO

GenericDAO <|-- ReporteDAO
GenericDAO <|-- ReclamacionDAO
GenericDAO <|-- CategoriaDAO
GenericDAO <|-- UsuarioDAO
GenericDAO ..> JPAUtil
@enduml
