<%-- Encabezado común. Cada vista define antes la variable «titulo». --%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${titulo}"/> · EncuentraEPN</title>
    <link rel="stylesheet" href="${ctx}/lib/leaflet/leaflet.css">
    <link rel="stylesheet" href="${ctx}/css/estilos.css">
</head>
<body>
<header class="barra">
    <a class="marca" href="${ctx}/inicio">EncuentraEPN</a>
    <nav>
        <a href="${ctx}/reportes">Mapa de reportes</a>
        <a href="${ctx}/reportes/nuevo">Registrar reporte</a>
    </nav>
    <div class="sesion">
        <c:choose>
            <c:when test="${not empty sessionScope.usuario}">
                <span><c:out value="${sessionScope.usuario.nombre}"/></span>
                <a href="${ctx}/salir">Salir</a>
            </c:when>
            <c:otherwise>
                <a href="${ctx}/identificacion">Identificarse</a>
            </c:otherwise>
        </c:choose>
    </div>
</header>
<main>
